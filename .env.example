# ============================================================
# LogChain - Zero-Trust Cross-Cloud Log Integrity System
# Environment Configuration Template
# ============================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ============================================================

# --- Blockchain Network ---
DEVICE1_IP=192.168.1.100
DEVICE2_IP=192.168.1.101

DEVICE1_RPC=http://192.168.1.100:8545
DEVICE2_RPC=http://192.168.1.101:8546

CHAIN_ID=12345

# --- Blockchain Credentials ---
# IMPORTANT: Generate a NEW key pair - never reuse compromised keys.
# Run: python scripts/preflight_check.py --gen-key
BLOCKCHAIN_PRIVATE_KEY=0xYOUR_NEW_PRIVATE_KEY_HERE
BLOCKCHAIN_ACCOUNT=0xYOUR_ACCOUNT_ADDRESS_HERE

# --- Contract ---
# Set after running: ./scripts/deploy_contract.sh
CONTRACT_ADDRESS=

# --- MongoDB ---
MONGODB_URI=mongodb://localhost:27017/logchain_db
MONGODB_DB_NAME=logchain_db

# --- Flask ---
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=CHANGE_ME_GENERATE_A_RANDOM_SECRET
FLASK_DEBUG=false
FLASK_PORT=5000
INGEST_API_TOKEN=lc-ingest-secret-token-change-in-production

# --- Demo ---
DEMO_CASE_ID=CASE-001
DEMO_EVENT_COUNT=100
DEMO_LOG_DIR=demo/sample_logs
