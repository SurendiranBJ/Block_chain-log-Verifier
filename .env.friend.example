# ============================================================
# LogChain - Friend Cloud Adapter Configuration (.env.friend)
# Role: Cloud Log Getter & Remote Ingestion Client (Laptop 2 or 3)
# SECURITY: Zero blockchain keys, Zero MongoDB credentials!
# ============================================================

# Target Device 1 Main System on LAN
DEVICE1_IP=192.168.1.100
DEVICE1_INGEST_URL=http://192.168.1.100:5000/api/ingest
INGEST_API_TOKEN=lc-ingest-secret-token-change-in-production

# Cloud Provider Selection: aws or azure
CLOUD_PROVIDER=aws

# AWS Settings (if pulling live CloudTrail events)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_CLOUDTRAIL_NAME=

# Azure Settings (if pulling live Azure Monitor Activity Log events)
AZURE_SUBSCRIPTION_ID=
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_RESOURCE_GROUP=
