# ============================================================
# LogChain - Device 2 Configuration (.env.device2)
# Role: Independent Validator Node (Laptop 2)
# SECURITY: Never copy Device 1 private keys or MongoDB credentials here!
# ============================================================

# Network Configuration
DEVICE2_IP=127.0.0.1
DEVICE2_RPC=http://127.0.0.1:8546
CHAIN_ID=12345

# Device 1 LAN IP (needed for peer discovery & connection over Wi-Fi)
DEVICE1_IP=192.168.1.100

# Device 2 Independent Validator Account
# (Must have its OWN key pair, NOT Device 1's account!)
DEVICE2_ACCOUNT=0xYOUR_DEVICE2_INDEPENDENT_VALIDATOR_ADDRESS
DEVICE2_PRIVATE_KEY=0xYOUR_DEVICE2_PRIVATE_KEY
DEVICE2_PASSWORD=YOUR_DEVICE2_KEYSTORE_PASSWORD
