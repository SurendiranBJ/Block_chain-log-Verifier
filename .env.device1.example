# ============================================================
# LogChain - Device 1 Configuration (.env.device1)
# Role: Primary Main System (Backend, Dashboard, MongoDB, Geth Validator)
# ============================================================

# Network Configuration
DEVICE1_IP=127.0.0.1
DEVICE1_RPC=http://127.0.0.1:8545
CHAIN_ID=12345

# Device 1 Validator & Writer Account
# (Generate with: python scripts/setup_private_chain.py)
BLOCKCHAIN_ACCOUNT=0xYOUR_DEVICE1_VALIDATOR_ADDRESS
BLOCKCHAIN_PRIVATE_KEY=0xYOUR_DEVICE1_PRIVATE_KEY
BLOCKCHAIN_PASSWORD=YOUR_DEVICE1_KEYSTORE_PASSWORD

# LogIntegrityV3 Contract (populated after python scripts/deploy_contract.py)
CONTRACT_ADDRESS=

# MongoDB Configuration (Local to Device 1 ONLY - Never exposed to LAN)
MONGODB_URI=mongodb://localhost:27017/logchain_db
MONGODB_DB_NAME=logchain_db

# Flask Application & Dashboard
FLASK_SECRET_KEY=generate-a-secure-random-key-here
FLASK_DEBUG=false
FLASK_PORT=5000

# Ingestion API Authentication Token (Friend must pass this in X-API-Key header)
INGEST_API_TOKEN=lc-ingest-secret-token-change-in-production

# Demo Settings
DEMO_CASE_ID=CASE-001
DEMO_EVENT_COUNT=100
DEMO_LOG_DIR=demo/sample_logs
